# --- Mode -------------------------------------------------------------
# STORE: memory (dev/test default) | firestore (required in production)
STORE=memory
# AUTH_MODE: dev (local only; refused in production) | firebase
AUTH_MODE=dev

# --- GST provider -----------------------------------------------------
# mock | gstinapi | whitebooks   (mock refused when NODE_ENV=production; gstinapi/whitebooks not yet implemented)
GST_PROVIDER=mock
# --- Provider throughput constraints (ISSUE-005). ALL UNVERIFIED for any real vendor. Enforced ONLY in src/providers/gate.ts ---
# Sustained requests per minute. One GST check = 2 provider requests (verify + returns), or 1 if returns are skipped.
GST_RATE_LIMIT_PER_MIN=60
# Max simultaneous in-flight provider requests
GST_MAX_CONCURRENT=5
GST_TIMEOUT_MS=15000
GST_RETRIES=2
GST_BACKOFF_BASE_MS=500
GST_BACKOFF_MAX_MS=8000
# Circuit breaker: consecutive timeouts/unavailable before the provider is treated as DOWN, and fail-fast cooldown
GST_BREAKER_THRESHOLD=5
GST_BREAKER_COOLDOWN_MS=30000
# Bulk worker parallelism (effective max = GST_MAX_CONCURRENT)
BULK_CONCURRENCY=5

# --- Firebase (browser; safe to expose) -------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase Admin (SERVER ONLY, secret) -----------------------------
# On Cloud Run use Application Default Credentials and leave these empty.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Browser auth: dev = local accounts (no Firebase). Ignored/disabled in production builds.
NEXT_PUBLIC_AUTH_MODE=dev

# --- Verification freshness and provider health (defaults shown; all optional) ---
# VERIFY_FRESH_MS=86400000            # a stored answer younger than this is served instantly (24 h)
# VERIFY_STALE_USABLE_MS=604800000    # older than FRESH but younger than this: shown immediately, refreshed quietly (7 d)
# VERIFY_HEALTH_WINDOW_MS=300000      # provider health looks at this much recent history (5 min)
# VERIFY_HEALTH_MAX_SAMPLES=30
# VERIFY_HEALTH_MIN_SAMPLES=5         # fewer samples than this never mark the provider degraded
# VERIFY_DEGRADED_FAILURE_RATE=0.3    # failure share that marks the provider "degraded"
# VERIFY_DEGRADED_P95_MS=6000         # p95 latency that marks the provider "degraded"
# VERIFY_DOWN_CONSECUTIVE=5           # consecutive failures that mark it "down" (lookups fail fast)
# VERIFY_DOWN_HOLD_MS=30000           # how long "down" holds before a probe is allowed
# VERIFY_PROBE_INTERVAL_MS=10000

# --- Cost protection (defaults shown; all optional) -------------------------------
# VERIFY_SHARED_CACHE=off             # "on" reuses a public registry answer across organizations (no org/user/note data is shared)
# VERIFY_MIN_REFRESH_MS=0             # minimum age before a live refresh of a stored answer is allowed
# VERIFY_ORG_PER_MINUTE=120           # per-organization live-call ceiling (in-process window)
# VERIFY_ORG_PER_DAY=5000
# VERIFY_GLOBAL_PER_DAY=0             # 0 = no global daily ceiling
# PROVIDER_MONTHLY_CREDIT_BUDGET=     # empty = unlimited; when set, live checks pause as credits run out
# PROVIDER_CREDITS_PER_CALL=1
# VERIFY_LOW_CREDIT_FRACTION=0.2
# VERIFY_CRITICAL_CREDIT_FRACTION=0.05
# PROVIDER_COST_PER_CREDIT_INR=       # empty = cost in rupees is not shown (price unverified)
# OPERATOR_UIDS=                      # comma-separated Firebase UIDs allowed to see operator cost/provider pages

# --- Scheduler ---------------------------------------------------------------------
# CRON_SECRET=                        # >= 24 chars. Enables POST /api/internal/portfolio-due (Bearer token). Unset = endpoint returns 404.

# --- Development / staging ONLY (refused or rejected in production) -----------------
# ALLOW_MOCK_IN_PRODUCTION=true-for-staging-only   # staging override: allows the FAKE mock provider with NODE_ENV=production
# MOCK_NOT_FOUND=                     # comma-separated GSTINs the mock provider reports as "no registration"
# MOCK_TIMEOUT=                       # comma-separated GSTINs the mock provider times out on
# MOCK_DELAY_MS=                      # artificial provider delay in ms
